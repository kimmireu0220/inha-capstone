| --- | --- | --- |
| P04:gray_original | 0.031317, 0.035929 | 0.009740, 0.011787 |
| P04:navy_original | 0.357267, 0.348433 | 0.014939, 0.014983 |
| P04:gray_cable | 0.058794, 0.069336 | 0.012361, 0.009896 |
| P04:navy_cable | 0.416527, 0.402979 | 0.010348, 0.018053 |
| P05:gray_original | 0.031764, 0.026543 | 0.016274, 0.016006 |
| P05:navy_original | 0.398822, 0.418161 | 0.015213, 0.021229 |
| P05:gray_cable | 0.064049, 0.057595 | 0.019989, 0.023958 |
| P05:navy_cable | 0.465070, 0.467267 | 0.016726, 0.019514 |
| P06:gray_original | 0.060711, 0.029365 | 0.009516, 0.010838 |
| P06:navy_original | 0.410180, 0.392517 | 0.014364, 0.010499 |
